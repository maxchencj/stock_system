# 环境变量配置文件
# 复制此文件为 .env 并填写实际值

# ═══════════════════════════════════════════════════════════
#  AI 配置（必填）
# ═══════════════════════════════════════════════════════════
DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com  # 默认官方地址，可替换为代理

# ═══════════════════════════════════════════════════════════
#  通知配置（可选）
# ═══════════════════════════════════════════════════════════

# PushPlus 微信推送（获取token: https://www.pushplus.plus/）
PUSHPLUS_TOKEN=

# Telegram Bot（获取token: @BotFather）
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# 邮件通知（可选）
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_TO=

# ═══════════════════════════════════════════════════════════
#  数据库配置（可选）
# ═══════════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379/0

# ═══════════════════════════════════════════════════════════
#  Web 配置
# ═══════════════════════════════════════════════════════════
SECRET_KEY=stock-system-secret-2024
